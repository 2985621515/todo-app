{
  "name": "todo-electron",
  "version": "1.0.0",
  "description": "Todo 应用桌面版",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder build",
    "postinstall": "electron-builder install-app-deps"
    
  },
  "dependencies": {
    "sqlite3": "^6.0.1",
    "sqlite": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^33.3.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.todo.app",
    "productName": "G-Todo",
    "directories": {
      "output": "dist"
    },
    "icon": "Todo.ico",
       "files": [
      "main.js",
      "preload.js",
      "Todo.ico",
      {
        "from": "../react-demo/dist",
        "to": "react-demo/dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "${productName}.${ext}"
    },
    "asar": true
  }
}
